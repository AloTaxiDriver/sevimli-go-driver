{
  "expo": {
    "name": "Sevimli Go Driver",
    "slug": "SevimliGoDriver",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/sevimli-icon.png",
    "scheme": "sevimligodriver",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Sevimli Go haydovchi ilovasi sizning joylashuvingizni xaritada ko'rsatish va buyurtmalarni yo'naltirish uchun ishlatadi.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Ilova yopiq turganda ham joylashuvingiz dispetcherga yuboriladi — shunda sizga eng yaqin buyurtmalar tushadi va safar davomida aloqa uzilmaydi.",
        "UIBackgroundModes": ["location"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/sevimli-icon-adaptive.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "WAKE_LOCK",
        "POST_NOTIFICATIONS",
        "USE_FULL_SCREEN_INTENT",
        "SYSTEM_ALERT_WINDOW"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDIciAXrlg7Y0DQTZUPf5GwhGRlbz4jULc"
        }
      },
      "package": "com.aslzodiy3.SevimliGoDriver",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/sevimli-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/sevimli-splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      "@react-native-firebase/crashlytics",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Ilova yopiq turganda ham joylashuvingiz dispetcherga yuboriladi — shunda sizga eng yaqin buyurtmalar tushadi va safar davomida aloqa uzilmaydi.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "./plugins/withOverlayPermission.js",
      "./plugins/withNotificationSound.js"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5fddebdd-6900-4ae6-b522-fd6ab5fdf9ba"
      }
    },
    "owner": "aslzodiy3"
  }
}
