rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // YORDAMCHI FUNKSIYALAR
    // ============================================================
    function isSignedIn() {
      return request.auth != null;
    }
    // Dashboard xodimining roli — adminRoles/{uid} hujjatidan.
    // MUHIM: bu FAQAT dashboard xodimlari (admin/manager/depecher)
    // uchun — mijoz va haydovchi ilovalari bu hujjatga ega emas.
    function staffRole() {
      return get(/databases/$(database)/documents/adminRoles/$(request.auth.uid)).data.role;
    }
    function staffBranches() {
      return get(/databases/$(database)/documents/adminRoles/$(request.auth.uid)).data.branches;
    }
    // MUHIM: `exists()` tekshiruvi ATAYLAB. Usiz, xodim hujjati
    // bo'lmagan foydalanuvchi uchun `get(...).data.role` ifodasi
    // xatoga uchrardi — natija baribir "rad etish" bo'lardi, lekin
    // xato holatida `||` shoxlari kutilmagan tarzda baholanishi
    // mumkin. Endi javob aniq: hujjat yo'q -> false.
    function hasStaffDoc() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/adminRoles/$(request.auth.uid));
    }
    function isAdmin() {
      return hasStaffDoc() && staffRole() == 'admin';
    }
    function isStaff() {
      return hasStaffDoc() && staffRole() in ['admin', 'manager', 'depecher'];
    }

    // Bu maydonlarni FAQAT Cloud Function yozadi (Admin SDK qoidalarni
    // butunlay chetlab o'tadi, shuning uchun bu ro'yxat server
    // hisob-kitobiga umuman xalaqit bermaydi). Mijoz va haydovchi
    // ilovalari ularni faqat O'QIYDI — kod bo'ylab tekshirildi.
    function serverMoneyFields() {
      return [
        'bonusApplied', 'bonusCompensation', 'bonusEarned', 'bonusCompensationDriverId',
        'commissionApplied', 'commissionAmount', 'commissionDriverId',
        'driverBonusChecked', 'driverBonusDriverId', 'driverBonusStatsDate',
        'driverBonusStatsWeek', 'driverBonusDailyCounted', 'driverBonusWeeklyCounted',
        'driverBonusPerOrderAmount', 'moneyRevertedAt', 'ratingCounted'
      ];
    }
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Dashboard xodimi — rol hujjati bo'yicha (`isStaff()`), YOKI eski
    // yo'l bilan (email/parol bilan kirgan). Ikkinchisi ATAYLAB
    // saqlanmoqda: birinchi (bootstrap) admin hisobida `adminRoles`
    // hujjati bo'lmasligi mumkin — dashboard'ning o'zi ham rol
    // topilmasa "admin" deb hisoblaydi. Uni birdaniga olib tashlash
    // panelni butunlay ishdan chiqarib qo'yishi mumkin edi.
    //
    // MUHIM: bu yumshoq shox PULGA tegadigan joylarda ISHLAMAYDI.
    function customerReader() {
      return isStaff() ||
        (isSignedIn() && request.auth.token.firebase.sign_in_provider == 'password');
    }

    // ============================================================
    // ORDERS / DRIVERS
    // ============================================================
    // Haydovchi ilovasi hozircha Firebase Auth ISHLATMAYDI
    // (telefon+parolni to'g'ridan-to'g'ri Firestore'dan tekshiradi).
    // Shu sabab bu yerga "tizimga kirgan bo'lish" talabini qo'yib
    // bo'lmaydi — ilova butunlay ishlamay qolardi. To'liq himoya
    // uchun haydovchi ilovasini real Firebase Auth'ga o'tkazish
    // kerak; bu alohida, kelajakdagi ish.
    //
    // Shunga qaramay, avvalgi holat juda xavfli edi: ikkalasi ham
    // shunchaki `if true` edi, ya'ni internetdagi HAR KIM istalgan
    // haydovchining BALANSINI xohlagan raqamga o'zgartira olardi,
    // parolini almashtirib hisobini egallay olardi, yoki o'z
    // buyurtmasiga `commissionApplied: true` yozib qo'yib komissiya
    // to'lamasdan ishlay olardi.
    //
    // Endi autentifikatsiyasiz mijoz PULGA TEGISHLI maydonlarga
    // umuman tegolmaydi — qolgan hamma narsa avvalgidek ishlayveradi
    // (joylashuv, onlayn/band holati, buyurtma qabul qilish, bekor
    // qilish, yakuniy narx). Dashboard xodimi esa (u haqiqiy Firebase
    // Auth bilan kiradi) hech qanday cheklovga uchramaydi.
    // ============================================================
    // Haydovchi ilovasi (Firebase Auth'siz) buyurtmada FAQAT shu
    // maydonlarni o'zgartiradi — kod bo'ylab tekshirilgan:
    //   acceptOrder           -> status, driverId, acceptedAt
    //   updateOrderStatus     -> status
    //   finalizeOrderPrice    -> price, finalPrice, actualDistanceKm
    //   cancelOrder           -> status, cancelReason, cancelledBy, cancelledAt
    //   revertOrderAcceptance -> status, driverId
    function driverOrderFields() {
      return [
        'status', 'driverId', 'acceptedAt',
        'price', 'finalPrice', 'actualDistanceKm',
        'cancelReason', 'cancelledBy', 'cancelledAt'
      ];
    }
    // Mijoz ilovasi (haqiqiy Firebase Auth bilan) o'zgartiradigan
    // maydonlar: qo'shimcha xizmatlar, bonus, olib ketish nuqtasi,
    // bekor qilish.
    function customerOrderFields() {
      return [
        'extras', 'extrasTotal', 'bonusUsed', 'finalPrice',
        'pickupLat', 'pickupLng', 'fromAddress',
        'status', 'cancelReason', 'cancelledBy',
        // Safar oxirida mijoz qo'ygan baho. U haydovchi hujjatiga
        // EMAS, shu yerga yoziladi — haydovchi hujjati
        // autentifikatsiyasiz yoziladi, ya'ni u yerga baho yozish
        // har kimga istalgan reytingni "chizib qo'yish"ga yo'l
        // ochib berardi. O'rtacha reytingni Cloud Function hisoblaydi.
        'customerRating'
      ];
    }
    // Dispetcher panelidan tahrirlanadigan maydonlar. `bonusUsed` va
    // `extrasTotal` ATAYLAB YO'Q — panel ularni yozmaydi, va aynan
    // shu ikkitasi orqali pul o'g'irlash mumkin edi.
    function dispatcherOrderFields() {
      return [
        'customerName', 'customerPhone', 'fromAddress', 'toAddress', 'note',
        'price', 'finalPrice', 'driverId', 'status', 'branchId',
        'tariffId', 'tariffName', 'perKm', 'minDistance', 'minDistancePrice',
        'distanceKm', 'pickupLat', 'pickupLng', 'dropoffLat', 'dropoffLng',
        'cancelReason', 'cancelledBy', 'cancelledAt'
      ];
    }

    match /orders/{orderId} {
      allow read: if true;
      // Yangi buyurtma allaqachon "komissiya olingan" deb belgilangan
      // holda tug'ilmasin.
      allow create: if isStaff() ||
        !request.resource.data.keys().hasAny(serverMoneyFields());

      allow update: if
        // 1) Xodim — cheklovsiz (haqiqiy Firebase Auth + adminRoles).
        isStaff()
        // 2) Buyurtma EGASI (mijoz ilovasi) — faqat o'z maydonlari.
        //    `get(..., '')` ATAYLAB: maydon yo'q hujjatda
        //    `resource.data.customerId` ni to'g'ridan-to'g'ri o'qish
        //    qoidani XATOGA olib keladi.
        || (isSignedIn() &&
            request.auth.uid == resource.data.get('customerId', '') &&
            changedKeys().hasOnly(customerOrderFields()))
        // 3) Haydovchi ilovasi — autentifikatsiyasiz, shuning uchun
        //    ro'yxat QAT'IY.
        //
        //    MUHIM: avval bu shox "server maydonlariga tegmasa —
        //    qolgan hammasi mumkin" edi. Ya'ni internetdagi har kim
        //    `price: 0` yoki `extrasTotal: 100000000` yozib qo'ya
        //    olardi. Komissiya ham, bonus ham AYNAN shu ikkisidan
        //    hisoblanadi (computeTripTotal = price + extrasTotal):
        //    birinchisi bilan haydovchi umrbod komissiyasiz ishlardi,
        //    ikkinchisi bilan istalgan haydovchining balansini
        //    manfiyga tushirib, uni butunlay ishdan to'xtatish mumkin
        //    edi (balans <= 0 bo'lsa ilova buyurtma qabul qildirmaydi).
        //    `extrasTotal` endi FAQAT mijozniki.
        || changedKeys().hasOnly(driverOrderFields())
        // 4) Rol hujjati hali yaratilmagan dashboard xodimi (bootstrap
        //    admin) — panel maydonlari. `customerReader()` izohiga
        //    qarang: bu yumshoq shox ataylab qoldirilgan, lekin u ham
        //    `bonusUsed`/`extrasTotal` ga TEGOLMAYDI.
        || (customerReader() && changedKeys().hasOnly(dispatcherOrderFields()));

      // Xodim keraksiz/sinov buyurtmasini o'chira olishi kerak. Avval
      // bu `if false` edi — panelda "O'chirish" tugmasi bor, lekin u
      // hech qachon ishlamasdi va xatoni jimgina yutardi: dispetcher
      // tugmani bosaverar, satr esa joyida qolaverardi.
      allow delete: if isStaff() || customerReader();
    }
    match /drivers/{driverId} {
      allow read: if true;
      // Ro'yxatdan o'tish autentifikatsiyasiz bo'ladi — lekin yangi
      // haydovchi o'ziga balans "sovg'a qilib" tug'ila olmaydi.
      allow create: if isStaff() ||
        !request.resource.data.keys().hasAny(['balance']) ||
        request.resource.data.balance == 0;
      // `balance` — pul. `password` — hisobga kirish (ilovada parolni
      // o'zgartirish imkoniyati umuman yo'q, faqat ro'yxatdan o'tishda
      // bir marta yoziladi).
      // `balance` — pul, `password` — hisobga kirish. Bulardan
      // tashqari yana ikkitasi qo'shildi:
      //   `approved` — rad etilgan yoki hali tasdiqlanmagan haydovchi
      //     o'zini tasdiqlab qo'ymasin (u holda tizimga kirib, buyurtma
      //     ola boshlardi);
      //   `branch` — begona filialning navbatiga o'zini qo'shib
      //     qo'ymasin (dispatch faqat shu maydonga qarab filtrlaydi).
      // Ikkalasini ham haydovchi ilovasi YANGILAMAYDI — ular faqat
      // ro'yxatdan o'tishda, hujjat YARATILGANDA yoziladi.
      allow update: if isStaff() ||
        !changedKeys().hasAny(['balance', 'password', 'approved', 'branch']);
      // MUHIM: avval bu yerda `allow write: if true` turardi va pastda
      // `allow delete: if false` yozilgan edi. Firestore qoidalari
      // BIR-BIRINI BEKOR QILMAYDI — ular OR bilan qo'shiladi, va
      // `write` o'chirishni ham qamrab oladi. Ya'ni har kim istalgan
      // haydovchini o'chirib tashlay olardi. Endi `write` uch qismga
      // ajratilgani uchun o'chirish haqiqatan ham taqiqlangan.
      //
      // MUHIM: lekin XODIMGA ruxsat berilishi SHART. Eski qoidada
      // `write: if true` o'chirishni ham qamrab olgani uchun dashboard
      // haydovchini o'chira olardi; `write` ajratilganda bu imkoniyat
      // bilmasdan yo'qolgan edi. Oqibati: `deleteDriver` xatoni yutib
      // yuborardi, haydovchi ekrandan yo'qolardi, lekin hujjat joyida
      // qolib, u tizimga kiraverardi va sahifa yangilanganda qaytib
      // chiqardi — ishdan bo'shatilgan haydovchini o'chirib bo'lmasdi.
      allow delete: if isStaff();

      // ============================================================
      // ICHKI KOLLEKSIYALAR — BONUS HISOBI
      // ============================================================
      // MUHIM: `match /drivers/{driverId}` ichki kolleksiyalarni
      // QAMRAMAYDI. Ular pastdagi `match /{document=**}` ga tushib,
      // hammaga (jumladan haydovchining O'ZIGA) taqiqlangan edi.
      //
      // Oqibati jonli tizimda tekshirildi: bu uchala yo'l ham
      // PERMISSION_DENIED qaytarardi. Ya'ni haydovchi ilovasidagi
      // kunlik/haftalik bonus kartalari va paneldagi bonus tabi
      // hech qachon ma'lumot o'qiy olmagan — ikkalasi ham xatoni
      // yutib, bo'sh ko'rsatgan. Bonus tizimi yozilgan, hisoblangan
      // va to'langan, lekin KO'RINMAGAN.
      //
      // (`customers/{uid}/bonusHistory` uchun bunday ichki qoida
      // allaqachon yozilgan — shu yerda esa unutilgan.)
      //
      // Yozish faqat Cloud Function'ga tegishli (Admin SDK qoidalarni
      // chetlab o'tadi), shuning uchun mijoz tomondan yozish
      // taqiqlangan: haydovchi o'z bonus hisobini o'zi to'ldira
      // olmasin.
      match /dailyBonusStats/{statId} {
        allow read: if true;
        allow write: if false;
      }
      match /weeklyBonusStats/{statId} {
        allow read: if true;
        allow write: if false;
      }
      match /bonusHistory/{historyId} {
        allow read: if true;
        allow write: if false;
      }
    }

    // ============================================================
    // SETTINGS — o'qish ochiq qoladi (haydovchi/mijoz ilovasi
    // autentifikatsiyasiz turli sozlamalarni — masalan
    // driverBonus — o'qiydi). Yozish: admin cheklovsiz (shu jumladan
    // "bonus"/"driverBonus" — filiallar uchun umumiy STANDART
    // sozlama). Menejer esa FAQAT o'z filialiga tegishli, alohida
    // hujjat sifatida saqlanadigan bonus-override'ni yoza oladi:
    // "bonus_branch_{filialId}" yoki "driverBonus_branch_{filialId}",
    // faqat shu {filialId} o'ziga (adminRoles/{uid}.branches) tegishli
    // bo'lsagina.
    // ============================================================
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin() || (
        isStaff() && staffRole() == 'manager' &&
        (settingId.matches('bonus_branch_.+') || settingId.matches('driverBonus_branch_.+')) &&
        settingId.split('_branch_')[1] in staffBranches()
      );
    }

    // ============================================================
    // TARIFFS — mijoz/haydovchi ilovasi narx ko'rsatish uchun
    // autentifikatsiyasiz o'qiydi, shu sabab o'qish ochiq qoladi.
    // Yozish: admin cheklovsiz; menejer FAQAT o'z filial(lar)iga
    // tegishli (branchIds maydoni to'liq o'zining filiallariga mos
    // keladigan, bo'sh bo'lmagan) tarifni yarata/tahrirlay/o'chira
    // oladi — "barcha filiallar uchun umumiy" (bo'sh branchIds)
    // tarifni faqat admin yarata oladi.
    // ============================================================
    match /tariffs/{tariffId} {
      allow read: if true;
      allow create, update: if isAdmin() || (
        isStaff() && staffRole() == 'manager' &&
        request.resource.data.branchIds is list &&
        request.resource.data.branchIds.size() > 0 &&
        request.resource.data.branchIds.hasOnly(staffBranches())
      );
      allow delete: if isAdmin() || (
        isStaff() && staffRole() == 'manager' &&
        resource.data.branchIds is list &&
        resource.data.branchIds.size() > 0 &&
        resource.data.branchIds.hasOnly(staffBranches())
      );
    }

    // ============================================================
    // NOTIFICATIONS — dispetcher/menejer haydovchilarga yuboradigan
    // bildirishnoma. Haydovchi ilovasi buni autentifikatsiyasiz
    // o'qiydi (qo'ng'iroqcha belgisi), shu sabab o'qish ochiq.
    // Yozish faqat tizimga kirgan xodimga — bu maydon avval umuman
    // qoidalarda yo'q edi, ya'ni bildirishnoma yuborish (rasmli ham,
    // rasmsiz ham) jimgina rad etilib kelgan.
    // ============================================================
    match /notifications/{notificationId} {
      allow read: if true;
      allow create: if isStaff();
      allow update, delete: if false;
    }

    // ============================================================
    // DASHBOARD DATA — filiallar/tariflar (dashboard nusxasi)/
    // mijozlar/ishchilar/xizmatlar/manzillar/guruhlar/tranzaksiyalar
    // kabi bo'limlar shu yerda bitta JSON matn (`value`) sifatida
    // saqlanadi. Bu format qoidalar ICHKARIDAGI (masalan bitta
    // filialga tegishli) elementlarni tekshirishga imkon bermaydi —
    // shu sabab yozish faqat tizimga kirgan xodimga (ilgari — HAR KIM,
    // hatto tizimga kirmasdan ham yoza olardi). O'QISH esa ATAYLAB
    // ochiq: mijoz ilovasi (filiallar — eng yaqinini topish uchun,
    // qo'shimcha xizmatlar) va haydovchi ilovasi bu hujjatlarni
    // AUTENTIFIKATSIYASIZ o'qiydi — tariffs/settings kolleksiyalari
    // bilan bir xil qoida. Filial darajasidagi nozik cheklov dashboard
    // ilovasining o'zida (public/admin/index.html) amalga oshiriladi.
    // ============================================================
    match /dashboardData/{docId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // ============================================================
    // CUSTOMERS / ADMIN ROLES — o'zgarishsiz (joriy jonli
    // qoidalardan olingan, allaqachon to'g'ri auth-asosli).
    // ============================================================
    // MUHIM: bu blokda avval `sign_in_provider == 'password'` sharti
    // "dashboard xodimi" degan ma'noda ishlatilardi. Bu XAVFLI xato
    // edi — u kirish USULINI tekshiradi, ROLNI emas. Email/parol
    // provayderi loyihada yoqilgan (xodimlar shu bilan kiradi), va
    // Firebase'ning ochiq API kaliti bilan HAR KIM o'ziga email/parol
    // hisobi ochib olishi mumkin. Ya'ni istalgan begona odam:
    //   * barcha mijozlarning ismi va telefon raqamini o'qiy olardi;
    //   * O'ZIGA istalgan miqdorda `bonusBalance` yozib qo'ya olardi,
    //     keyin uni haqiqiy safarda ishlatardi — kompaniya esa o'sha
    //     summani haydovchiga naqd pulda qoplab berardi.
    // Endi shart ROLGA bog'langan: `isStaff()` — ya'ni adminRoles/{uid}
    // hujjatiga ega dashboard xodimi.
    match /customers/{uid} {
      // TODO (xavfsizlik): `customerReader()` dagi ikkinchi shox
      // email/parol bilan ro'yxatdan o'tgan HAR QANDAY hisobga barcha
      // mijozlarning ismi va telefonini ochib beradi. Uni olib tashlash
      // uchun avval har bir xodimda `adminRoles/{uid}` hujjati borligiga
      // ishonch hosil qilish kerak (dashboard > Ishchilar > kirish
      // huquqi), keyin bu yerda `isStaff()` qoldiriladi.
      allow read: if (isSignedIn() && request.auth.uid == uid) || customerReader();

      allow create: if isSignedIn() && request.auth.uid == uid &&
        request.resource.data.bonusBalance == 0;

      // ============================================================
      // MUHIM — BU YERDA KATTA TESHIK BOR EDI
      // ============================================================
      // Avval shart shunday edi: `sign_in_provider == 'password'`, ya'ni
      // "email/parol bilan kirgan bo'lsa, mijoz hujjatiga XOHLAGANINI
      // yozsin". Bu kirish USULINI tekshiradi, ROLNI emas — va
      // Firebase'ning ochiq API kaliti bilan HAR KIM o'ziga email/parol
      // hisobi ochib olishi mumkin.
      //
      // Ya'ni istalgan begona odam o'ziga `bonusBalance: 10000000` yozib
      // qo'yib, keyin uni haqiqiy safarda ishlatardi — kompaniya esa
      // o'sha summani haydovchiga naqd pulda qoplab berardi.
      //
      // Endi BALANSGA tegish uchun haqiqiy rol (`adminRoles` hujjati)
      // talab qilinadi. Balansga tegmaydigan yozuvlar (mijozning o'z
      // ismi, telefoni, push tokeni) avvalgidek ishlayveradi.
      allow update: if
        // Mijozning o'zi — balansdan tashqari hamma narsa.
        (isSignedIn() && request.auth.uid == uid &&
         request.resource.data.bonusBalance == resource.data.bonusBalance)
        // Xodim — cheklovsiz (panelda qo'lda bonus qo'shish).
        || isStaff()
        // Rol hujjati hali yaratilmagan xodim — lekin BALANSGA
        // TEGOLMAYDI.
        || (customerReader() &&
            request.resource.data.bonusBalance == resource.data.bonusBalance);

      match /bonusHistory/{historyId} {
        allow read: if (isSignedIn() && request.auth.uid == uid) || customerReader();
        // Yozuvni odatda Cloud Function yaratadi (Admin SDK qoidalarni
        // chetlab o'tadi); panel ham qo'lda bonus qo'shganda yozadi.
        // Mijozning O'ZI esa "bonus qo'shildi" degan soxta yozuv yasay
        // olmasin.
        allow create: if customerReader();
      }
    }
    match /adminRoles/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/adminRoles/$(request.auth.uid)).data.role == 'admin';
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
